{
  "name": "hhgoa",
  "version": "1.0.0",
  "description": "WAT framework — Frame in Goa 2026 graphic maker",
  "type": "module",
  "scripts": {
    "dev": "node tools/sync-assets.js && concurrently \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "vite --config web/vite.config.js",
    "dev:server": "node tools/share-server.js",
    "build": "node tools/sync-assets.js && vite build --config web/vite.config.js",
    "start": "node tools/share-server.js",
    "preview": "npm run build && npm run start"
  },
  "keywords": ["wat", "hh-goa", "frame-in-goa"],
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^4.21.2",
    "heic2any": "^0.0.4",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
